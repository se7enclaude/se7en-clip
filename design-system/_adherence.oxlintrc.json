{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/media/**",
              "ui_kits/desktop/**",
              "ui_kits/desktop/launch/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Syne|Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Syne, Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|mono|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, mono, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|warning|info|solid|inverse)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'success' | 'warning' | 'info' | 'solid' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|fullWidth|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, fullWidth, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|light)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|beforeBlock|afterBlock|seed|beforeLabel|afterLabel|ratio|initial|style|key|ref|className|style|children)$/]",
        "message": "<CompareSlider> doesn't accept that prop. Declared props: src, beforeBlock, afterBlock, seed, beforeLabel, afterLabel, ratio, initial, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|eyebrow|children|footer|onClose|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, eyebrow, children, footer, onClose, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|source|kind|specs|status|progress|speed|onAction|style|key|ref|className|style|children)$/]",
        "message": "<DownloadItem> doesn't accept that prop. Declared props: title, source, kind, specs, status, progress, speed, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:video|photo|audio)$/]",
        "message": "<DownloadItem> kind must be one of 'video' | 'photo' | 'audio'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:queued|downloading|upscaling|done|error)$/]",
        "message": "<DownloadItem> status must be one of 'queued' | 'downloading' | 'upscaling' | 'done' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|radius|tone|style|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: children, padding, radius, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|solid)$/]",
        "message": "<GlassPanel> tone must be one of 'dark' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|label|active|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, label, active, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|glass|light)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'solid' | 'glass' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|label|ratio|radius|kind|block|seed|children|style|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: src, label, ratio, radius, kind, block, seed, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:video|photo|audio)$/]",
        "message": "<MediaFrame> kind must be one of 'video' | 'photo' | 'audio'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|block|animateFrom|duration|seed|ratio|grid|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<PixelImage> doesn't accept that prop. Declared props: src, block, animateFrom, duration, seed, ratio, grid, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|height|showValue|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, height, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|success|neutral)$/]",
        "message": "<ProgressBar> tone must be one of 'accent' | 'success' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepIndex'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|style|key|ref|className|style|children)$/]",
        "message": "<StepIndex> doesn't accept that prop. Declared props: current, total, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|description|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, description, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|message|action|onClose|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, title, message, action, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|error|accent)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'success' | 'error' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|placement|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, children, placement, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='placement'] > Literal[value!=/^(?:top|bottom|right)$/]",
        "message": "<Tooltip> placement must be one of 'top' | 'bottom' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrlInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|icon|action|size|error|disabled|style|key|ref|className|style|children)$/]",
        "message": "<UrlInput> doesn't accept that prop. Declared props: value, onChange, placeholder, icon, action, size, error, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrlInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<UrlInput> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
